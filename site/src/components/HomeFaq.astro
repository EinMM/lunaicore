---
// Short FAQ (plain headings and paragraphs, no script). Text in data/home.ts.
import { homeMore } from "../data/home";

const { lang } = Astro.props;
const t = homeMore[lang as "en" | "ar"].faq;
---
<section class="home-block" id="faq">
  <div class="container">
    <h2>{t.title}</h2>
    <div class="feature-grid home-list">
      {t.items.map((item) => (
        <article class="feature-card">
          <h3>{item.q}</h3>
          <p>{item.a}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .home-block { padding-block: 56px; }
  .home-list { margin: 24px 0 0; }
  @media (max-width: 850px) { .home-block { padding-block: 40px; } }
</style>