---
// The Luna AI Core home body, one language. Text from data/home.ts; the sections below the cards are components.
import HomeSteps from "./HomeSteps.astro";
import HomePrinciples from "./HomePrinciples.astro";
import HomeVision from "./HomeVision.astro";
import HomeFaq from "./HomeFaq.astro";
import HomeBand from "./HomeBand.astro";
import { home } from "../data/home";
import { routes } from "../data/routes";

const { lang } = Astro.props;
const t = home[lang as "en" | "ar"];
const l = lang as "en" | "ar";
const icons = ["computer", "folder", "shield"];
---
<section>
  <div class="container narrow page-block">
    <h1>{t.heading}</h1>
    <p>{t.line}</p>
    <div class="page-actions">
      <a class="button" href={routes.productsDesktop[l]}><span>{t.buttonProduct}</span></a>
      <a class="button secondary" href={routes.downloads[l]}><span>{t.buttonDownload}</span></a>
    </div>
  </div>
</section>

<section class="section-texture home-block" id="product">
  <div class="container split">
    <div>
      <div class="eyebrow">{t.card.eyebrow}</div>
      <h2>{t.card.title}</h2>
      <p>{t.card.text}</p>
      <div class="page-actions">
        <a class="button" href={routes.productsDesktop[l]}><span>{t.card.link}</span></a>
      </div>
    </div>
    <img class="product-image" loading="lazy" decoding="async" src="/assets/screenshots/luna-main-interface.webp" alt={t.card.imageAlt}>
  </div>
</section>

<section class="home-block">
  <div class="container">
    <div class="feature-grid">
      {t.teasers.map((item, i) => (
        <article class="feature-card">
          <img class="feature-icon" src={`/assets/icons/${icons[i]}.svg`} alt="" aria-hidden="true">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<HomeSteps lang={l} />
<HomePrinciples lang={l} />
<HomeVision lang={l} />
<HomeFaq lang={l} />
<HomeBand lang={l} />

<style>
  /* .page-main section { padding: 0 } (prose.css) leaves these blocks without vertical space: give the home blocks their own. Scoped to the home only. */
  .home-block {
    padding-block: 56px;
  }
  @media (max-width: 850px) {
    .home-block {
      padding-block: 40px;
    }
  }
</style>