---
import Base from "../layouts/Base.astro";
import { release } from "../data/release";
import { meta as defaultMeta } from "../i18n/en";

// Props: the page says whether it is indexable, where the language link goes, and may override the meta.
const { noindex = false, altHref, meta = defaultMeta } = Astro.props;
---
<Base meta={meta} lang="en" assetPrefix="/" noindex={noindex}>

  <a class="skip-link" href="#main" data-en="Skip to content" data-ar="تخطَّ إلى المحتوى">Skip to content</a>
  <div class="progress" aria-hidden="true"><span></span></div>
  <header class="navbar">
    <div class="container nav-inner">
      <a class="brand" href="#" aria-label="Luna">
        <img src="/assets/logo/luna-logo-flat.png" alt="Luna">
      </a>

      <nav class="nav-links" aria-label="Main"
           data-aria-en="Main" data-aria-ar="الرئيسية">
        <a href="#meet" data-en="Meet Luna" data-ar="تعرّف على لونا">Meet Luna</a>
        <a href="#features" data-en="Why Luna" data-ar="لماذا لونا">Why Luna</a>
        <a href="#showcase" data-en="Showcase" data-ar="استعراض البرنامج">Showcase</a>
        <a href="#privacy" data-en="Privacy" data-ar="الخصوصية">Privacy</a>
        <a href="#providers" data-en="Providers" data-ar="المزوّدون">Providers</a>
        <a href="#faq" data-en="FAQ" data-ar="الأسئلة الشائعة">FAQ</a>
      </nav>

      <div class="nav-actions">
        <a class="lang-button" id="languageToggle" href={altHref} hreflang="ar" lang="ar">عربي</a>
        <a class="button" href={release.downloadUrl}
           data-en="Download" data-ar="تحميل">Download</a>
        <button class="menu-button" id="menuButton" type="button"
                aria-expanded="false" aria-controls="drawer" aria-label="Open menu"
                data-aria-en="Open menu" data-aria-ar="فتح القائمة"><i></i><i></i><i></i></button>
      </div>
    </div>
  </header>

  <!-- Section rail (wide screens) -->
  <nav class="rail" id="rail" aria-label="Page sections"
       data-aria-en="Page sections" data-aria-ar="أقسام الصفحة"></nav>

  <!-- Side menu -->
  <div class="drawer-backdrop" id="drawerBackdrop"></div>
  <aside class="drawer" id="drawer" aria-label="Menu" data-aria-en="Menu" data-aria-ar="القائمة">
    <div class="drawer-head">
      <img src="/assets/logo/luna-logo-flat.png" alt="Luna">
      <button class="drawer-close" id="drawerClose" type="button" aria-label="Close menu"
              data-aria-en="Close menu" data-aria-ar="إغلاق القائمة">&times;</button>
    </div>

    <nav aria-label="Page sections" data-aria-en="Page sections" data-aria-ar="أقسام الصفحة">
      <ol class="drawer-list" id="drawerList"></ol>
    </nav>

    <div class="drawer-foot">
      <div class="social-wrap">
        <p class="drawer-label" data-en="Follow Luna" data-ar="تابع لونا">Follow Luna</p>
        <div class="social" data-social-list></div>
      </div>
      <a class="button" href={release.downloadUrl}
         data-en="Download for Windows" data-ar="تحميل لنظام Windows">Download for Windows</a>
    </div>
  </aside>

  <main id="main">
    <!-- 01 HERO -->
    <section class="hero" id="top">
      <img class="hero-mark" src="/assets/logo/luna-logo-neon.png" alt="" aria-hidden="true">
      <div class="container">
        <div class="hero-content">
          <div class="eyebrow"
               data-en="LUNA AI DESKTOP ASSISTANT"
               data-ar="مساعد لونا للذكاء الاصطناعي">
            LUNA AI DESKTOP ASSISTANT
          </div>

          <h1>
            <span data-en="Your AI. Your PC."
                  data-ar="ذكاؤك الاصطناعي.">Your AI. Your PC.</span>
            <br>
            <span class="gradient-text"
                  data-en="Your Rules."
                  data-ar="جهازك. قواعدك.">Your Rules.</span>
          </h1>

          <p class="hero-description"
             data-en="A local-first AI desktop assistant designed around privacy, control, and productivity."
             data-ar="مساعد ذكاء اصطناعي لسطح المكتب، صُمم ليمنحك الخصوصية والتحكم والإنتاجية، مع أولوية التشغيل المحلي.">
            A local-first AI desktop assistant designed around privacy, control, and productivity.
          </p>

          <div class="hero-actions">
            <a class="button" href={release.downloadUrl}>
              <img class="button-icon" src="/assets/icons/download.svg" alt="" aria-hidden="true">
              <span data-en="Download for Windows"
                    data-ar="تحميل لنظام Windows">Download for Windows</span>
            </a>
            <a class="button secondary" href="#meet"
               data-en="Discover Luna"
               data-ar="اكتشف لونا">
              Discover Luna
            </a>
          <div class="social-wrap hero-social">
            <div class="social" data-social-list role="group"
                 aria-label="Social media"
                 data-aria-en="Social media" data-aria-ar="وسائل التواصل الاجتماعي"></div>
          </div>
          </div>

          <div class="hero-meta">
            <span data-en={`${release.betaLabel} (v${release.version}) · Windows 11 recommended · English & Arabic · ${release.sizeMB} MB`}
                  data-ar={`${release.betaLabelAr} (v${release.version}) · يُوصى بنظام Windows 11 · العربية والإنجليزية · ${release.sizeMB} ميجابايت`}>{release.betaLabel} (v{release.version}) · Windows 11 recommended · English & Arabic · {release.sizeMB} MB</span>
            ·
            <a href={release.releaseUrl}
               data-en="Release notes" data-ar="ملاحظات الإصدار">Release notes</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 MEET LUNA -->
    <section id="meet" class="section-texture">
      <div class="container split">
        <div>
          <div class="eyebrow" data-en="MEET LUNA" data-ar="تعرّف على لونا">MEET LUNA</div>
          <h2 data-en="AI that works on your terms."
              data-ar="ذكاء اصطناعي يعمل وفق اختياراتك.">
            AI that works on your terms.
          </h2>
          <p data-en="Luna brings local AI, file assistance, personal memory, and optional cloud intelligence into one Windows desktop experience."
             data-ar="تجمع لونا بين الذكاء الاصطناعي المحلي ومساعدة الملفات والذاكرة الشخصية والذكاء السحابي الاختياري، ضمن تجربة واحدة على Windows.">
            Luna brings local AI, file assistance, personal memory, and optional cloud intelligence into one Windows desktop experience.
          </p>
        </div>
        <img class="product-image" loading="lazy" decoding="async"
             src="/assets/screenshots/luna-main-interface.webp"
             alt="Luna main interface">
      </div>
    </section>

    <!-- 03 WHY LUNA -->
    <section id="features">
      <div class="container">
        <div class="section-heading">
          <div class="eyebrow" data-en="WHY LUNA" data-ar="لماذا لونا">WHY LUNA</div>
          <h2 data-en="More than a chat window."
              data-ar="أكثر من مجرد نافذة محادثة.">
            More than a chat window.
          </h2>
          <p data-en="A desktop assistant designed to help you work with your conversations, files, and knowledge."
             data-ar="مساعد لسطح المكتب يساعدك في محادثاتك وملفاتك ومعرفتك الشخصية.">
            A desktop assistant designed to help you work with your conversations, files, and knowledge.
          </p>
        </div>

        <div class="feature-grid">
          <article class="feature-card">
            <img class="feature-icon" src="/assets/icons/brain.svg" alt="" aria-hidden="true">
            <h3 data-en="Conversations" data-ar="المحادثات">Conversations</h3>
            <p data-en="A flexible workspace for your AI conversations."
               data-ar="مساحة مرنة لتنظيم محادثاتك مع الذكاء الاصطناعي.">A flexible workspace for your AI conversations.</p>
          </article>

          <article class="feature-card">
            <img class="feature-icon" src="/assets/icons/folder.svg" alt="" aria-hidden="true">
            <h3 data-en="File Assistant" data-ar="مساعد الملفات">File Assistant</h3>
            <p data-en="Search, organize, and work with your files with confirmation."
               data-ar="ابحث عن ملفاتك ونظّمها وتعامل معها بعد تأكيدك.">Search, organize, and work with your files with confirmation.</p>
          </article>

          <article class="feature-card">
            <img class="feature-icon" src="/assets/icons/memory.svg" alt="" aria-hidden="true">
            <h3 data-en="Personal Memory" data-ar="الذاكرة الشخصية">Personal Memory</h3>
            <p data-en="Luna remembers information when you explicitly ask."
               data-ar="تتذكر لونا المعلومات عندما تطلب منها ذلك صراحةً.">Luna remembers information when you explicitly ask.</p>
          </article>

          <article class="feature-card">
            <img class="feature-icon" src="/assets/icons/documents.svg" alt="" aria-hidden="true">
            <h3 data-en="Document Intelligence" data-ar="فهم المستندات">Document Intelligence</h3>
            <p data-en="Search and work with supported documents."
               data-ar="ابحث داخل المستندات المدعومة واعمل معها.">Search and work with supported documents.</p>
          </article>

          <article class="feature-card">
            <img class="feature-icon" src="/assets/icons/computer.svg" alt="" aria-hidden="true">
            <h3 data-en="Local AI Engine" data-ar="محرك ذكاء محلي">Local AI Engine</h3>
            <p data-en="Run local models on your own computer."
               data-ar="شغّل النماذج المحلية على جهازك.">Run local models on your own computer.</p>
          </article>

          <article class="feature-card">
            <img class="feature-icon" src="/assets/icons/cloud.svg" alt="" aria-hidden="true">
            <h3 data-en="Hybrid Intelligence" data-ar="الذكاء الهجين">Hybrid Intelligence</h3>
            <p data-en="Choose when to use optional cloud services."
               data-ar="اختر متى تريد استخدام الخدمات السحابية الاختيارية.">Choose when to use optional cloud services.</p>
          </article>

          <article class="feature-card">
            <img class="feature-icon" src="/assets/icons/globe.svg" alt="" aria-hidden="true">
            <h3 data-en="Web Search & Reading" data-ar="قراءة الويب والبحث">Web Search & Reading</h3>
            <p data-en="Luna reads a page from a link you write and searches the web with your own key. You choose Off, Ask first or Allowed, and a private conversation never uses the web."
               data-ar="تقرأ لونا صفحة من رابط تكتبه وتبحث في الويب بمفتاحك أنت. تختار «مغلق» أو «اسأل أولًا» أو «مسموح»، والمحادثة الخاصة لا تستخدم الويب أبدًا.">Luna reads a page from a link you write and searches the web with your own key. You choose Off, Ask first or Allowed, and a private conversation never uses the web.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- 04 PRODUCT SHOWCASE -->
    <section id="showcase" class="section-texture">
      <div class="container">
        <div class="section-heading">
          <div class="eyebrow" data-en="PRODUCT SHOWCASE" data-ar="استعراض لونا">PRODUCT SHOWCASE</div>
          <h2 data-en="Designed for real work."
              data-ar="مصممة لإنجاز أعمال حقيقية.">
            Designed for real work.
          </h2>
        </div>

        <div class="showcase-grid">
          <article class="showcase-item">
            <img loading="lazy" decoding="async" src="/assets/screenshots/luna-arabic-chat.webp" alt="Arabic conversation">
            <h3 data-en="Natural conversations" data-ar="محادثات طبيعية">Natural conversations</h3>
            <p data-en="Work in English or Arabic."
               data-ar="تحدّث بالإنجليزية أو العربية.">Work in English or Arabic.</p>
          </article>

          <article class="showcase-item">
            <img loading="lazy" decoding="async" src="/assets/screenshots/luna-file-assistant.webp" alt="File assistant">
            <h3 data-en="Your files, within reach" data-ar="ملفاتك في متناولك">Your files, within reach</h3>
            <p data-en="Search and manage files with permission controls."
               data-ar="ابحث عن الملفات وأدرها مع ضوابط الصلاحيات.">Search and manage files with permission controls.</p>
          </article>

          <article class="showcase-item">
            <img loading="lazy" decoding="async" src="/assets/screenshots/luna-privacy-settings.webp" alt="Privacy settings">
            <h3 data-en="Control your privacy" data-ar="تحكم بخصوصيتك">Control your privacy</h3>
            <p data-en="Manage access and control your data."
               data-ar="تحكم في الوصول إلى ملفاتك وبياناتك.">Manage access and control your data.</p>
          </article>

          <article class="showcase-item">
            <img loading="lazy" decoding="async" src="/assets/screenshots/luna-knowledge.webp" alt="Knowledge and memory">
            <h3 data-en="Knowledge that stays organized" data-ar="معرفة منظمة">Knowledge that stays organized</h3>
            <p data-en="Search your personal knowledge and supported documents."
               data-ar="ابحث في معرفتك الشخصية ومستنداتك المدعومة.">Search your personal knowledge and supported documents.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- 05 PRIVACY -->
    <section id="privacy">
      <div class="container split">
        <div>
          <div class="eyebrow" data-en="PRIVACY & SECURITY" data-ar="الخصوصية والأمان">PRIVACY & SECURITY</div>
          <h2 data-en="Your data. Your decisions."
              data-ar="بياناتك. قراراتك.">
            Your data. Your decisions.
          </h2>
          <p data-en="Luna is local-first. File operations require confirmation, folder access is controlled, and cloud use remains optional."
             data-ar="تعتمد لونا التشغيل المحلي أولًا. تتطلب عمليات الملفات تأكيدك، وتخضع صلاحيات المجلدات للتحكم، ويبقى استخدام السحابة اختياريًا.">
            Luna is local-first. File operations require confirmation, folder access is controlled, and cloud use remains optional.
          </p>
        </div>
        <img class="product-image" loading="lazy" decoding="async"
             src="/assets/screenshots/luna-privacy-settings.webp"
             alt="Luna privacy controls">
      </div>
    </section>

    <!-- 06 LOCAL & HYBRID -->
    <section id="modes" class="section-texture">
      <div class="container">
        <div class="section-heading">
          <div class="eyebrow" data-en="LOCAL & HYBRID INTELLIGENCE"
              data-ar="الذكاء المحلي والهجين">LOCAL & HYBRID INTELLIGENCE</div>
          <h2 data-en="Choose how Luna thinks."
              data-ar="اختر كيف تعمل لونا.">
            Choose how Luna thinks.
          </h2>
          <p data-en="Start locally and choose cloud processing when you need it."
             data-ar="ابدأ بالمعالجة المحلية، واختر المعالجة السحابية عندما تحتاج إليها.">
            Start locally and choose cloud processing when you need it.
          </p>
        </div>

        <div class="mode-grid">
          <article class="mode">
            <h3><img class="mode-icon" src="/assets/icons/computer.svg" alt="" aria-hidden="true"><span data-en="Local" data-ar="محلي">Local</span></h3>
            <p data-en="Everything runs on your computer with Luna Engine, and can work without internet after the model is installed."
               data-ar="كل شيء يعمل على جهازك عبر محرّك لونا، ويمكنه العمل دون إنترنت بعد تثبيت النموذج.">Everything runs on your computer with Luna Engine, and can work without internet after the model is installed.</p>
          </article>
          <article class="mode">
            <h3><img class="mode-icon" src="/assets/icons/cloud.svg" alt="" aria-hidden="true"><span data-en="Cloud" data-ar="سحابي">Cloud</span></h3>
            <p data-en="Use Google Gemini or OpenAI with your own API key, stored securely on your PC."
               data-ar="استخدم Google Gemini أو OpenAI بمفتاح API الخاص بك، ويُحفظ المفتاح بأمان على جهازك.">Use Google Gemini or OpenAI with your own API key, stored securely on your PC.</p>
          </article>
          <article class="mode">
            <h3><img class="mode-icon" src="/assets/icons/brain.svg" alt="" aria-hidden="true"><span data-en="Hybrid" data-ar="هجين">Hybrid</span></h3>
            <p data-en="Local and cloud together, in one of two styles:"
               data-ar="المحلي والسحابة معًا، بأحد أسلوبين:">Local and cloud together, in one of two styles:</p>
            <ul class="mode-options">
              <li><strong data-en="Balanced" data-ar="متوازن">Balanced</strong>
                <span data-en="Starts with the local engine. The cloud steps in when the local engine is unavailable, or when your PC can only run it on the CPU. Messages Luna detects as sensitive stay on your PC. This detection helps, but it may not catch everything."
                      data-ar="يبدأ بالمحرك المحلي، وتتدخل السحابة عند عدم توفره أو عندما يستطيع جهازك تشغيله على المعالج (CPU) فقط. وتبقى الرسائل التي تكتشف لونا أنها حساسة على جهازك. وهذا الاكتشاف يساعد، لكنه قد لا يلتقط كل شيء.">Starts with the local engine. The cloud steps in when the local engine is unavailable, or when your PC can only run it on the CPU. Messages Luna detects as sensitive stay on your PC. This detection helps, but it may not catch everything.</span></li>
              <li><strong data-en="Lighten the PC" data-ar="تخفيف الجهاز">Lighten the PC</strong>
                <span data-en="The cloud handles everyday requests, while messages Luna detects as sensitive stay on your PC. This detection helps, but it may not catch everything."
                      data-ar="تتولى السحابة الطلبات العادية، وتبقى الرسائل التي تكتشف لونا أنها حساسة على جهازك. وهذا الاكتشاف يساعد، لكنه قد لا يلتقط كل شيء.">The cloud handles everyday requests, while messages Luna detects as sensitive stay on your PC. This detection helps, but it may not catch everything.</span></li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- 06a COMPARISON -->
    <section id="compare">
      <div class="container">
        <div class="section-heading">
          <div class="eyebrow" data-en="HONEST COMPARISON" data-ar="مقارنة صريحة">HONEST COMPARISON</div>
          <h2 data-en="How is Luna different?" data-ar="كيف تختلف لونا؟">How is Luna different?</h2>
          <p data-en="Three kinds of AI assistants, differing in where the AI runs, how much control you have over your files, and how well they support Arabic."
             data-ar="ثلاثة أنواع من المساعدات الذكية، وتختلف في المكان الذي يعمل فيه الذكاء، وفي تحكمك بملفاتك، وفي دعم العربية.">Three kinds of AI assistants, differing in where the AI runs, how much control you have over your files, and how well they support Arabic.</p>
        </div>

        <div class="compare-grid">
          <article class="compare-card">
            <h3 data-en="Cloud AI apps" data-ar="تطبيقات الذكاء السحابية">Cloud AI apps</h3>
            <dl>
            <dt data-en="Where does the AI run?" data-ar="أين يعمل الذكاء؟">Where does the AI run?</dt>
            <dd data-en="On the provider’s servers" data-ar="على خوادم المزوّد">On the provider’s servers</dd>
            <dt data-en="Arabic interface and conversations" data-ar="الواجهة والمحادثة بالعربية">Arabic interface and conversations</dt>
            <dd data-en="Varies by app" data-ar="تختلف بحسب التطبيق">Varies by app</dd>
            <dt data-en="Working with files" data-ar="التعامل مع الملفات">Working with files</dt>
            <dd data-en="Depends on uploading files to the provider" data-ar="يعتمد على رفع الملفات إلى المزوّد">Depends on uploading files to the provider</dd>
            <dt data-en="Cloud use" data-ar="استخدام السحابة">Cloud use</dt>
            <dd data-en="Essential: the service stops without it" data-ar="أساسي، والخدمة تتوقف دونه">Essential: the service stops without it</dd>
            </dl>
          </article>
          <article class="compare-card">
            <h3 data-en="General local-model tools" data-ar="أدوات النماذج المحلية العامة">General local-model tools</h3>
            <dl>
            <dt data-en="Where does the AI run?" data-ar="أين يعمل الذكاء؟">Where does the AI run?</dt>
            <dd data-en="On your PC" data-ar="على جهازك">On your PC</dd>
            <dt data-en="Arabic interface and conversations" data-ar="الواجهة والمحادثة بالعربية">Arabic interface and conversations</dt>
            <dd data-en="Varies by tool" data-ar="تختلف بحسب الأداة">Varies by tool</dd>
            <dt data-en="Working with files" data-ar="التعامل مع الملفات">Working with files</dt>
            <dd data-en="Varies by tool" data-ar="يختلف بحسب الأداة">Varies by tool</dd>
            <dt data-en="Cloud use" data-ar="استخدام السحابة">Cloud use</dt>
            <dd data-en="Optional in some tools" data-ar="اختياري في بعض الأدوات">Optional in some tools</dd>
            </dl>
          </article>
          <article class="compare-card us">
            <h3>Luna</h3>
            <dl>
            <dt data-en="Where does the AI run?" data-ar="أين يعمل الذكاء؟">Where does the AI run?</dt>
            <dd data-en="You choose local or cloud AI." data-ar="تختار أنت بين الذكاء المحلي والسحابي.">You choose local or cloud AI.</dd>
            <dt data-en="Arabic interface and conversations" data-ar="الواجهة والمحادثة بالعربية">Arabic interface and conversations</dt>
            <dd data-en="Full Arabic interface and conversations, alongside English" data-ar="واجهة ومحادثات عربية كاملة، إلى جانب الإنجليزية">Full Arabic interface and conversations, alongside English</dd>
            <dt data-en="Working with files" data-ar="التعامل مع الملفات">Working with files</dt>
            <dd data-en="Every file operation asks for your confirmation, and each folder has its own permission (read-only or full access)" data-ar="كل عملية على الملفات تطلب تأكيدك، وصلاحية كل مجلد مستقلة (قراءة فقط أو وصول كامل)">Every file operation asks for your confirmation, and each folder has its own permission (read-only or full access)</dd>
            <dt data-en="Cloud use" data-ar="استخدام السحابة">Cloud use</dt>
            <dd data-en="Always optional, with your own API key stored in Windows Credential Manager" data-ar="اختياري دائمًا، بمفتاح API الخاص بك المحفوظ في مدير بيانات اعتماد Windows">Always optional, with your own API key stored in Windows Credential Manager</dd>
            </dl>
          </article>
        </div>

        <p class="provider-note" data-en="This comparison describes general categories as of November 2026; individual products within each category may differ."
           data-ar="تصف هذه المقارنة الأنواع العامة وفق حالتها في نوفمبر 2026، وقد تختلف المنتجات الفردية داخل كل نوع.">This comparison describes general categories as of November 2026; individual products within each category may differ.</p>
      </div>
    </section>

    <!-- 06b SUPPORTED PROVIDERS -->
    <section id="providers" class="section-texture">
      <div class="container">
        <div class="section-heading">
          <div class="eyebrow" data-en="SUPPORTED PROVIDERS" data-ar="المزوّدون المدعومون">SUPPORTED PROVIDERS</div>
          <h2 data-en="Bring the engine you trust."
              data-ar="اختر المحرّك الذي تثق به.">
            Bring the engine you trust.
          </h2>
          <p data-en="Luna works with the engines and services below. AI requests never pass through a Luna server: local models run on your PC, and cloud providers are reached directly with your own API key."
             data-ar="تعمل لونا مع المحرّكات والخدمات التالية. لا تمرّ طلبات الذكاء الاصطناعي عبر أي خادم تابع للونا: النماذج المحلية تعمل على جهازك، ويُتصل بمزوّدي السحابة مباشرةً بمفتاح API الخاص بك.">
            Luna works with the engines and services below. AI requests never pass through a Luna server: local models run on your PC, and cloud providers are reached directly with your own API key.
          </p>
        </div>

        <div class="provider-groups">
          <article class="provider-group">
            <h3><img class="mode-icon" src="/assets/icons/computer.svg" alt="" aria-hidden="true"><span data-en="Local models" data-ar="النماذج المحلية">Local models</span></h3>
            <p data-en="Models run on Luna Engine, built on llama.cpp. They can work without internet after a model is installed."
               data-ar="تعمل النماذج على محرّك لونا المبني على llama.cpp، ويمكنها العمل دون إنترنت بعد تثبيت النموذج.">Models run on Luna Engine, built on llama.cpp. They can work without internet after a model is installed.</p>
            <ul class="provider-list">
              <li class="provider">
                <span class="provider-mark" aria-hidden="true">GE</span>
                <div>
                  <strong>Gemma</strong>
                  <small data-en="Google’s open model family, run locally on your PC."
                         data-ar="عائلة نماذج Google المفتوحة، وتعمل محليًا على جهازك.">Google’s open model family, run locally on your PC.</small>
                </div>
              </li>
              <li class="provider">
                <span class="provider-mark" aria-hidden="true">QW</span>
                <div>
                  <strong>Qwen</strong>
                  <small data-en="Alibaba’s open model family, run locally on your PC."
                         data-ar="عائلة نماذج Alibaba المفتوحة، وتعمل محليًا على جهازك.">Alibaba’s open model family, run locally on your PC.</small>
                </div>
              </li>
            </ul>
          </article>

          <article class="provider-group">
            <h3><img class="mode-icon" src="/assets/icons/cloud.svg" alt="" aria-hidden="true"><span data-en="Cloud AI" data-ar="ذكاء سحابي">Cloud AI</span></h3>
            <p data-en="Optional. Use your own API key, stored in Windows Credential Manager."
               data-ar="اختياري. استخدم مفتاح API الخاص بك، ويُحفظ في مدير بيانات اعتماد Windows.">Optional. Use your own API key, stored in Windows Credential Manager.</p>
            <ul class="provider-list">
              <li class="provider">
                <span class="provider-mark" aria-hidden="true">GM</span>
                <div>
                  <strong>Google Gemini</strong>
                  <small data-en="Connect with your own Google AI API key."
                         data-ar="اتصل بمفتاح Google AI API الخاص بك.">Connect with your own Google AI API key.</small>
                </div>
              </li>
              <li class="provider">
                <span class="provider-mark" aria-hidden="true">OA</span>
                <div>
                  <strong>OpenAI</strong>
                  <small data-en="Connect with your own OpenAI API key."
                         data-ar="اتصل بمفتاح OpenAI API الخاص بك.">Connect with your own OpenAI API key.</small>
                </div>
              </li>
            </ul>
          </article>
        </div>

        <p class="provider-note"
           data-en="More providers are added one at a time, only after reviewing their privacy and terms. Provider names and trademarks belong to their owners; Luna is an independent project and is not affiliated with or endorsed by them."
           data-ar="يُضاف مزوّدون آخرون تدريجيًا، بعد مراجعة سياسة الخصوصية والشروط لكل منها. أسماء المزوّدين وعلاماتهم التجارية ملك لأصحابها، ولونا مشروع مستقل غير تابع لهم ولا مدعوم منهم.">
          More providers are added one at a time, only after reviewing their privacy and terms. Provider names and trademarks belong to their owners; Luna is an independent project and is not affiliated with or endorsed by them.
        </p>
