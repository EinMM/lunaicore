---
import Base from "../layouts/Base.astro";
import { release } from "../data/release";
import { meta as defaultMeta } from "../i18n/ar";

// Props: the page says whether it is indexable, where the language link goes, and may override the meta.
const { noindex = false, altHref, meta = defaultMeta } = Astro.props;
---
<Base meta={meta} lang="ar" dir="rtl" bodyDir="rtl" assetPrefix="/" noindex={noindex}>

  <a class="skip-link" href="#main" data-en="Skip to content" data-ar="تخطَّ إلى المحتوى">تخطَّ إلى المحتوى</a>
  <div class="progress" aria-hidden="true"><span></span></div>
  <header class="navbar">
    <div class="container nav-inner">
      <a class="brand" href="#" aria-label="Luna">
        <img src="/assets/logo/luna-logo-flat.png" alt="Luna">
      </a>

      <nav class="nav-links" aria-label="الرئيسية"
           data-aria-en="Main" data-aria-ar="الرئيسية">
        <a href="#meet" data-en="Meet Luna" data-ar="تعرّف على لونا">تعرّف على لونا</a>
        <a href="#features" data-en="Why Luna" data-ar="لماذا لونا">لماذا لونا</a>
        <a href="#showcase" data-en="Showcase" data-ar="استعراض البرنامج">استعراض البرنامج</a>
        <a href="#privacy" data-en="Privacy" data-ar="الخصوصية">الخصوصية</a>
        <a href="#providers" data-en="Providers" data-ar="المزوّدون">المزوّدون</a>
        <a href="#faq" data-en="FAQ" data-ar="الأسئلة الشائعة">الأسئلة الشائعة</a>
      </nav>

      <div class="nav-actions">
        <a class="lang-button" id="languageToggle" href={altHref} hreflang="en" lang="en">English</a>
        <a class="button" href={release.downloadUrl}
           data-en="Download" data-ar="تحميل">تحميل</a>
        <button class="menu-button" id="menuButton" type="button"
                aria-expanded="false" aria-controls="drawer" aria-label="فتح القائمة"
                data-aria-en="Open menu" data-aria-ar="فتح القائمة"><i></i><i></i><i></i></button>
      </div>
    </div>
  </header>

  <!-- Section rail (wide screens) -->
  <nav class="rail" id="rail" aria-label="أقسام الصفحة"
       data-aria-en="Page sections" data-aria-ar="أقسام الصفحة"></nav>

  <!-- Side menu -->
  <div class="drawer-backdrop" id="drawerBackdrop"></div>
  <aside class="drawer" id="drawer" aria-label="القائمة" data-aria-en="Menu" data-aria-ar="القائمة">
    <div class="drawer-head">
      <img src="/assets/logo/luna-logo-flat.png" alt="Luna">
      <button class="drawer-close" id="drawerClose" type="button" aria-label="إغلاق القائمة"
              data-aria-en="Close menu" data-aria-ar="إغلاق القائمة">&times;</button>
    </div>

    <nav aria-label="أقسام الصفحة" data-aria-en="Page sections" data-aria-ar="أقسام الصفحة">
      <ol class="drawer-list" id="drawerList"></ol>
    </nav>

    <div class="drawer-foot">
      <div class="social-wrap">
        <p class="drawer-label" data-en="Follow Luna" data-ar="تابع لونا">تابع لونا</p>
        <div class="social" data-social-list></div>
      </div>
      <a class="button" href={release.downloadUrl}
         data-en="Download for Windows" data-ar="تحميل لنظام Windows">تحميل لنظام Windows</a>
    </div>
  </aside>

  <main id="main">
    <!-- 01 HERO -->
    <section class="hero" id="top">
      <img class="hero-mark" src="/assets/logo/luna-logo-neon.png" alt="" aria-hidden="true">
      <div class="container">
        <div class="hero-content">
          <div class="eyebrow"
               data-en="LUNA AI DESKTOP ASSISTANT"
               data-ar="مساعد لونا للذكاء الاصطناعي">مساعد لونا للذكاء الاصطناعي</div>

          <h1>
            <span data-en="Your AI. Your PC."
                  data-ar="ذكاؤك الاصطناعي.">ذكاؤك الاصطناعي.</span>
            <br>
            <span class="gradient-text"
                  data-en="Your Rules."
                  data-ar="جهازك. قواعدك.">جهازك. قواعدك.</span>
          </h1>

          <p class="hero-description"
             data-en="A local-first AI desktop assistant designed around privacy, control, and productivity."
             data-ar="مساعد ذكاء اصطناعي لسطح المكتب، صُمم ليمنحك الخصوصية والتحكم والإنتاجية، مع أولوية التشغيل المحلي.">مساعد ذكاء اصطناعي لسطح المكتب، صُمم ليمنحك الخصوصية والتحكم والإنتاجية، مع أولوية التشغيل المحلي.</p>

          <div class="hero-actions">
            <a class="button" href={release.downloadUrl}>
              <img class="button-icon" src="/assets/icons/download.svg" alt="" aria-hidden="true">
              <span data-en="Download for Windows"
                    data-ar="تحميل لنظام Windows">تحميل لنظام Windows</span>
            </a>
            <a class="button secondary" href="#meet"
               data-en="Discover Luna"
               data-ar="اكتشف لونا">اكتشف لونا</a>
          <div class="social-wrap hero-social">
            <div class="social" data-social-list role="group"
                 aria-label="وسائل التواصل الاجتماعي"
                 data-aria-en="Social media" data-aria-ar="وسائل التواصل الاجتماعي"></div>
          </div>
          </div>

          <div class="hero-meta">
            <span data-en={`${release.betaLabel} (v${release.version}) · Windows 11 recommended · English & Arabic · ${release.sizeMB} MB`}
                  data-ar={`${release.betaLabelAr} (v${release.version}) · يُوصى بنظام Windows 11 · العربية والإنجليزية · ${release.sizeMB} ميجابايت`}>{release.betaLabelAr} (v{release.version}) · يُوصى بنظام Windows 11 · العربية والإنجليزية · {release.sizeMB} ميجابايت</span>
            ·
            <a href={release.releaseUrl}
               data-en="Release notes" data-ar="ملاحظات الإصدار">ملاحظات الإصدار</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 MEET LUNA -->
    <section id="meet" class="section-texture">
      <div class="container split">
        <div>
          <div class="eyebrow" data-en="MEET LUNA" data-ar="تعرّف على لونا">تعرّف على لونا</div>
          <h2 data-en="AI that works on your terms."
              data-ar="ذكاء اصطناعي يعمل وفق اختياراتك.">ذكاء اصطناعي يعمل وفق اختياراتك.</h2>
          <p data-en="Luna brings local AI, file assistance, personal memory, and optional cloud intelligence into one Windows desktop experience."
             data-ar="تجمع لونا بين الذكاء الاصطناعي المحلي ومساعدة الملفات والذاكرة الشخصية والذكاء السحابي الاختياري، ضمن تجربة واحدة على Windows.">تجمع لونا بين الذكاء الاصطناعي المحلي ومساعدة الملفات والذاكرة الشخصية والذكاء السحابي الاختياري، ضمن تجربة واحدة على Windows.</p>
        </div>
        <img class="product-image" loading="lazy" decoding="async"
             src="/assets/screenshots/luna-main-interface.webp"
             alt="الواجهة الرئيسية للونا">
      </div>
    </section>

    <!-- 03 WHY LUNA -->
    <section id="features">
      <div class="container">
        <div class="section-heading">
          <div class="eyebrow" data-en="WHY LUNA" data-ar="لماذا لونا">لماذا لونا</div>
          <h2 data-en="More than a chat window."
              data-ar="أكثر من مجرد نافذة محادثة.">أكثر من مجرد نافذة محادثة.</h2>
          <p data-en="A desktop assistant designed to help you work with your conversations, files, and knowledge."
             data-ar="مساعد لسطح المكتب يساعدك في محادثاتك وملفاتك ومعرفتك الشخصية.">مساعد لسطح المكتب يساعدك في محادثاتك وملفاتك ومعرفتك الشخصية.</p>
        </div>

        <div class="feature-grid">
          <article class="feature-card">
            <img class="feature-icon" src="/assets/icons/brain.svg" alt="" aria-hidden="true">
            <h3 data-en="Conversations" data-ar="المحادثات">المحادثات</h3>
            <p data-en="A flexible workspace for your AI conversations."
               data-ar="مساحة مرنة لتنظيم محادثاتك مع الذكاء الاصطناعي.">مساحة مرنة لتنظيم محادثاتك مع الذكاء الاصطناعي.</p>
          </article>

          <article class="feature-card">
            <img class="feature-icon" src="/assets/icons/folder.svg" alt="" aria-hidden="true">
            <h3 data-en="File Assistant" data-ar="مساعد الملفات">مساعد الملفات</h3>
            <p data-en="Search, organize, and work with your files with confirmation."
               data-ar="ابحث عن ملفاتك ونظّمها وتعامل معها بعد تأكيدك.">ابحث عن ملفاتك ونظّمها وتعامل معها بعد تأكيدك.</p>
          </article>

          <article class="feature-card">
            <img class="feature-icon" src="/assets/icons/memory.svg" alt="" aria-hidden="true">
            <h3 data-en="Personal Memory" data-ar="الذاكرة الشخصية">الذاكرة الشخصية</h3>
            <p data-en="Luna remembers information when you explicitly ask."
               data-ar="تتذكر لونا المعلومات عندما تطلب منها ذلك صراحةً.">تتذكر لونا المعلومات عندما تطلب منها ذلك صراحةً.</p>
          </article>

          <article class="feature-card">
            <img class="feature-icon" src="/assets/icons/documents.svg" alt="" aria-hidden="true">
            <h3 data-en="Document Intelligence" data-ar="فهم المستندات">فهم المستندات</h3>
            <p data-en="Search and work with supported documents."
               data-ar="ابحث داخل المستندات المدعومة واعمل معها.">ابحث داخل المستندات المدعومة واعمل معها.</p>
          </article>

          <article class="feature-card">
            <img class="feature-icon" src="/assets/icons/computer.svg" alt="" aria-hidden="true">
            <h3 data-en="Local AI Engine" data-ar="محرك ذكاء محلي">محرك ذكاء محلي</h3>
            <p data-en="Run local models on your own computer."
               data-ar="شغّل النماذج المحلية على جهازك.">شغّل النماذج المحلية على جهازك.</p>
          </article>

          <article class="feature-card">
            <img class="feature-icon" src="/assets/icons/cloud.svg" alt="" aria-hidden="true">
            <h3 data-en="Hybrid Intelligence" data-ar="الذكاء الهجين">الذكاء الهجين</h3>
            <p data-en="Choose when to use optional cloud services."
               data-ar="اختر متى تريد استخدام الخدمات السحابية الاختيارية.">اختر متى تريد استخدام الخدمات السحابية الاختيارية.</p>
          </article>

          <article class="feature-card">
            <img class="feature-icon" src="/assets/icons/globe.svg" alt="" aria-hidden="true">
            <h3 data-en="Web Search & Reading" data-ar="قراءة الويب والبحث">قراءة الويب والبحث</h3>
            <p data-en="Luna reads a page from a link you write and searches the web with your own key. You choose Off, Ask first or Allowed, and a private conversation never uses the web."
               data-ar="تقرأ لونا صفحة من رابط تكتبه وتبحث في الويب بمفتاحك أنت. تختار «مغلق» أو «اسأل أولًا» أو «مسموح»، والمحادثة الخاصة لا تستخدم الويب أبدًا.">تقرأ لونا صفحة من رابط تكتبه وتبحث في الويب بمفتاحك أنت. تختار «مغلق» أو «اسأل أولًا» أو «مسموح»، والمحادثة الخاصة لا تستخدم الويب أبدًا.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- 04 PRODUCT SHOWCASE -->
    <section id="showcase" class="section-texture">
      <div class="container">
        <div class="section-heading">
          <div class="eyebrow" data-en="PRODUCT SHOWCASE" data-ar="استعراض لونا">استعراض لونا</div>
          <h2 data-en="Designed for real work."
              data-ar="مصممة لإنجاز أعمال حقيقية.">مصممة لإنجاز أعمال حقيقية.</h2>
        </div>

        <div class="showcase-grid">
          <article class="showcase-item">
            <img loading="lazy" decoding="async" src="/assets/screenshots/luna-arabic-chat.webp" alt="محادثة بالعربية">
            <h3 data-en="Natural conversations" data-ar="محادثات طبيعية">محادثات طبيعية</h3>
            <p data-en="Work in English or Arabic."
               data-ar="تحدّث بالإنجليزية أو العربية.">تحدّث بالإنجليزية أو العربية.</p>
          </article>

          <article class="showcase-item">
            <img loading="lazy" decoding="async" src="/assets/screenshots/luna-file-assistant.webp" alt="مساعد الملفات">
            <h3 data-en="Your files, within reach" data-ar="ملفاتك في متناولك">ملفاتك في متناولك</h3>
            <p data-en="Search and manage files with permission controls."
               data-ar="ابحث عن الملفات وأدرها مع ضوابط الصلاحيات.">ابحث عن الملفات وأدرها مع ضوابط الصلاحيات.</p>
          </article>

          <article class="showcase-item">
            <img loading="lazy" decoding="async" src="/assets/screenshots/luna-privacy-settings.webp" alt="إعدادات الخصوصية">
            <h3 data-en="Control your privacy" data-ar="تحكم بخصوصيتك">تحكم بخصوصيتك</h3>
            <p data-en="Manage access and control your data."
               data-ar="تحكم في الوصول إلى ملفاتك وبياناتك.">تحكم في الوصول إلى ملفاتك وبياناتك.</p>
          </article>

          <article class="showcase-item">
            <img loading="lazy" decoding="async" src="/assets/screenshots/luna-knowledge.webp" alt="المعرفة والذاكرة">
            <h3 data-en="Knowledge that stays organized" data-ar="معرفة منظمة">معرفة منظمة</h3>
            <p data-en="Search your personal knowledge and supported documents."
               data-ar="ابحث في معرفتك الشخصية ومستنداتك المدعومة.">ابحث في معرفتك الشخصية ومستنداتك المدعومة.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- 05 PRIVACY -->
    <section id="privacy">
      <div class="container split">
        <div>
          <div class="eyebrow" data-en="PRIVACY & SECURITY" data-ar="الخصوصية والأمان">الخصوصية والأمان</div>
          <h2 data-en="Your data. Your decisions."
              data-ar="بياناتك. قراراتك.">بياناتك. قراراتك.</h2>
          <p data-en="Luna is local-first. File operations require confirmation, folder access is controlled, and cloud use remains optional."
             data-ar="تعتمد لونا التشغيل المحلي أولًا. تتطلب عمليات الملفات تأكيدك، وتخضع صلاحيات المجلدات للتحكم، ويبقى استخدام السحابة اختياريًا.">تعتمد لونا التشغيل المحلي أولًا. تتطلب عمليات الملفات تأكيدك، وتخضع صلاحيات المجلدات للتحكم، ويبقى استخدام السحابة اختياريًا.</p>
        </div>
        <img class="product-image" loading="lazy" decoding="async"
             src="/assets/screenshots/luna-privacy-settings.webp"
             alt="أدوات التحكم بالخصوصية في لونا">
      </div>
    </section>

    <!-- 06 LOCAL & HYBRID -->
    <section id="modes" class="section-texture">
      <div class="container">
        <div class="section-heading">
          <div class="eyebrow" data-en="LOCAL & HYBRID INTELLIGENCE"
              data-ar="الذكاء المحلي والهجين">الذكاء المحلي والهجين</div>
          <h2 data-en="Choose how Luna thinks."
              data-ar="اختر كيف تعمل لونا.">اختر كيف تعمل لونا.</h2>
          <p data-en="Start locally and choose cloud processing when you need it."
             data-ar="ابدأ بالمعالجة المحلية، واختر المعالجة السحابية عندما تحتاج إليها.">ابدأ بالمعالجة المحلية، واختر المعالجة السحابية عندما تحتاج إليها.</p>
        </div>

        <div class="mode-grid">
          <article class="mode">
            <h3><img class="mode-icon" src="/assets/icons/computer.svg" alt="" aria-hidden="true"><span data-en="Local" data-ar="محلي">محلي</span></h3>
            <p data-en="Everything runs on your computer with Luna Engine, and can work without internet after the model is installed."
               data-ar="كل شيء يعمل على جهازك عبر محرّك لونا، ويمكنه العمل دون إنترنت بعد تثبيت النموذج.">كل شيء يعمل على جهازك عبر محرّك لونا، ويمكنه العمل دون إنترنت بعد تثبيت النموذج.</p>
          </article>
          <article class="mode">
            <h3><img class="mode-icon" src="/assets/icons/cloud.svg" alt="" aria-hidden="true"><span data-en="Cloud" data-ar="سحابي">سحابي</span></h3>
            <p data-en="Use Google Gemini or OpenAI with your own API key, stored securely on your PC."
               data-ar="استخدم Google Gemini أو OpenAI بمفتاح API الخاص بك، ويُحفظ المفتاح بأمان على جهازك.">استخدم Google Gemini أو OpenAI بمفتاح API الخاص بك، ويُحفظ المفتاح بأمان على جهازك.</p>
          </article>
          <article class="mode">
            <h3><img class="mode-icon" src="/assets/icons/brain.svg" alt="" aria-hidden="true"><span data-en="Hybrid" data-ar="هجين">هجين</span></h3>
            <p data-en="Local and cloud together, in one of two styles:"
               data-ar="المحلي والسحابة معًا، بأحد أسلوبين:">المحلي والسحابة معًا، بأحد أسلوبين:</p>
            <ul class="mode-options">
              <li><strong data-en="Balanced" data-ar="متوازن">متوازن</strong>
                <span data-en="Starts with the local engine. The cloud steps in when the local engine is unavailable, or when your PC can only run it on the CPU. Messages Luna detects as sensitive stay on your PC. This detection helps, but it may not catch everything."
                      data-ar="يبدأ بالمحرك المحلي، وتتدخل السحابة عند عدم توفره أو عندما يستطيع جهازك تشغيله على المعالج (CPU) فقط. وتبقى الرسائل التي تكتشف لونا أنها حساسة على جهازك. وهذا الاكتشاف يساعد، لكنه قد لا يلتقط كل شيء.">يبدأ بالمحرك المحلي، وتتدخل السحابة عند عدم توفره أو عندما يستطيع جهازك تشغيله على المعالج (CPU) فقط. وتبقى الرسائل التي تكتشف لونا أنها حساسة على جهازك. وهذا الاكتشاف يساعد، لكنه قد لا يلتقط كل شيء.</span></li>
              <li><strong data-en="Lighten the PC" data-ar="تخفيف الجهاز">تخفيف الجهاز</strong>
                <span data-en="The cloud handles everyday requests, while messages Luna detects as sensitive stay on your PC. This detection helps, but it may not catch everything."
                      data-ar="تتولى السحابة الطلبات العادية، وتبقى الرسائل التي تكتشف لونا أنها حساسة على جهازك. وهذا الاكتشاف يساعد، لكنه قد لا يلتقط كل شيء.">تتولى السحابة الطلبات العادية، وتبقى الرسائل التي تكتشف لونا أنها حساسة على جهازك. وهذا الاكتشاف يساعد، لكنه قد لا يلتقط كل شيء.</span></li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- 06a COMPARISON -->
    <section id="compare">
      <div class="container">
        <div class="section-heading">
          <div class="eyebrow" data-en="HONEST COMPARISON" data-ar="مقارنة صريحة">مقارنة صريحة</div>
          <h2 data-en="How is Luna different?" data-ar="كيف تختلف لونا؟">كيف تختلف لونا؟</h2>
          <p data-en="Three kinds of AI assistants, differing in where the AI runs, how much control you have over your files, and how well they support Arabic."
             data-ar="ثلاثة أنواع من المساعدات الذكية، وتختلف في المكان الذي يعمل فيه الذكاء، وفي تحكمك بملفاتك، وفي دعم العربية.">ثلاثة أنواع من المساعدات الذكية، وتختلف في المكان الذي يعمل فيه الذكاء، وفي تحكمك بملفاتك، وفي دعم العربية.</p>
        </div>

        <div class="compare-grid">
          <article class="compare-card">
            <h3 data-en="Cloud AI apps" data-ar="تطبيقات الذكاء السحابية">تطبيقات الذكاء السحابية</h3>
            <dl>
            <dt data-en="Where does the AI run?" data-ar="أين يعمل الذكاء؟">أين يعمل الذكاء؟</dt>
            <dd data-en="On the provider’s servers" data-ar="على خوادم المزوّد">على خوادم المزوّد</dd>
            <dt data-en="Arabic interface and conversations" data-ar="الواجهة والمحادثة بالعربية">الواجهة والمحادثة بالعربية</dt>
            <dd data-en="Varies by app" data-ar="تختلف بحسب التطبيق">تختلف بحسب التطبيق</dd>
