---
// /docs/ : the docs hub (short): the product, and the pages to start with. Text in data/docs.ts, titles from the manual.
import Page from "../layouts/Page.astro";
import { docsHome, docsUi, DOCS_BASE, DESKTOP_BASE, manualPages, slugOf, pathOf } from "../data/docs";

const { lang } = Astro.props;
const l = lang as "en" | "ar";
const t = docsHome[l];
const other = l === "en" ? "ar" : "en";
const pages = await manualPages(l);
const start = ["install", "requirements", "getting-started", "faq"].map((slug) => pages.find((page) => slugOf(page) === slug)).filter(Boolean);
---
<Page lang={l} title={t.hubTitle} description={t.hubDescription} path={DOCS_BASE[l]} altPath={DOCS_BASE[other]}>
  <div class="container narrow page-block">
    <h1>{t.hubHeading}</h1>
    <p>{t.lead}</p>
  </div>
  <div class="container narrow">
    <article class="feature-card">
      <h2><a href={DESKTOP_BASE[l]}>{t.productName}</a></h2>
      <p>{t.productText}</p>
    </article>
    <h2 class="docs-start">{t.popular}</h2>
    <ul class="docs-links">
      {start.map((page) => <li><a href={pathOf(l, slugOf(page!))}>{page!.data.title}</a></li>)}
    </ul>
  </div>
</Page>

<style>
  .feature-card h2 { margin: 0 0 10px; font-size: 24px; letter-spacing: 0; }
  .docs-start { margin: 40px 0 12px; font-size: 22px; letter-spacing: 0; }
  .docs-links { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .feature-card h2 a, .docs-links a { color: var(--cyan); text-decoration: underline; text-underline-offset: 3px; }
</style>