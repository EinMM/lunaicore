---
// Thin layout for the subpages (downloads, changelog, legal). One language per page.
// Shares the landing page's CSS source (site.css) and adds prose.css. No site.js and no GTM:
// the landing script assumes landing-only elements, and tracking is not carried to subpages.
import css from "../styles/site.css?raw";
import prose from "../styles/prose.css?raw";
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ui, SITE } from "../i18n/page";
import { altPathFor } from "../data/routes";

// altPath: derived from data/routes.ts; only a page outside the route list (the 404) passes its own.
// noindex: for the 404 page only (no canonical or hreflang; robots noindex instead).
const { lang, title, description, path, noindex = false } = Astro.props;
const altPath = Astro.props.altPath ?? altPathFor(path);
const t = ui[lang as "en" | "ar"];
const enPath = lang === "en" ? path : altPath;
const arPath = lang === "ar" ? path : altPath;
const styles = css.replaceAll('url("assets/', 'url("/assets/') + "\n" + prose;
---
<!DOCTYPE html>
<html lang={t.lang} dir={t.dir}>

<Head
  title={title}
  description={description}
  canonical={`${SITE}${path}`}
  alternates={{ en: `${SITE}${enPath}`, ar: `${SITE}${arPath}`, xDefault: `${SITE}${enPath}` }}
  noindex={noindex}
  og={{ title, description, url: `${SITE}${path}`, locale: t.ogLocale }}
  iconPrefix="/"
  styles={styles}
/>
<body dir={t.dir}>
  <Header lang={lang} path={path} altPath={altPath} />

  <main id="main" class="page-main">
    <slot />
  </main>

  <Footer lang={lang} />
</body>
</html>
