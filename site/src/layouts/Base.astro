---
// One layout for both languages. CSS and JS are the live page's, verbatim
// (src/styles/site.css, src/scripts/site.js); only the asset prefix differs per page.
import css from "../styles/site.css?raw";
import js from "../scripts/site.js?raw";
import Head from "../components/Head.astro";
import { entity } from "../data/entity";

const { meta, lang, dir, bodyDir, assetPrefix = "", noindex = false } = Astro.props;
const styles = css.replaceAll('url("assets/', `url("${assetPrefix}assets/`);
---
<!DOCTYPE html>
<html lang={lang} dir={dir}>

<Head
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  alternates={{ en: "https://lunaicore.com/", ar: "https://lunaicore.com/ar/", xDefault: "https://lunaicore.com/" }}
  og={{ title: meta.ogTitle, description: meta.ogDescription, url: meta.ogUrl, locale: meta.ogLocale, imageAlt: meta.ogImageAlt }}
  noindex={noindex}
  iconPrefix={assetPrefix}
  styles={styles}
/>
<body dir={bodyDir}>
<slot />

  <script is:inline set:html={js}></script>
</body>
</html>
