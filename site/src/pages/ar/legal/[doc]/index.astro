---
// /ar/legal/privacy/, /ar/legal/terms/, /ar/legal/security/ (Arabic). See the English route for the source.
import Page from "../../../../layouts/Page.astro";
import { getEntry, render } from "astro:content";
import { meta } from "../../../../i18n/ar";

export function getStaticPaths() {
  return ["privacy", "terms", "security"].map((doc) => ({ params: { doc } }));
}

const { doc } = Astro.params;
const entry = await getEntry("docs", `legal-${doc}-ar`);
if (!entry) throw new Error(`legal: docs entry legal-${doc}-ar is missing (run scripts/copy-docs.mjs)`);
const { Content } = await render(entry);
const title = entry.data.title as string;
---
<Page lang="ar" title={`${title} · لونا`} description={meta.description} path={`/ar/legal/${doc}/`} altPath={`/legal/${doc}/`}>
  <section>
    <div class="container narrow prose">
      <h1>{title}</h1>
      <Content />
    </div>
  </section>
</Page>
